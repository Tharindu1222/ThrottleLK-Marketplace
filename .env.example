NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host API → Docker Postgres (published on localhost:5432)
DATABASE_URL=postgresql://throttlelk:throttlelk@localhost:5432/throttlelk
POSTGRES_USER=throttlelk
POSTGRES_PASSWORD=throttlelk
POSTGRES_DB=throttlelk

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

SKIP_DB=false
SEED_DEMO=false

ADMIN_BOOTSTRAP_EMAIL=admin@throttlelk.lk
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeAdmin1!

# Email (optional — logs to console when unset)
# RESEND_API_KEY=
# EMAIL_FROM=ThrottleLK <noreply@yourdomain.lk>

# Cloudflare R2 (required for image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Rate limiting (ASVS 2.4.1 / 6.3.1)
# TRUST_PROXY=true when the API sits behind Cloudflare or nginx
# INTERNAL_API_KEY=  # same value on web + API so Next.js SSR is not IP-throttled

# Optional Redis cache (dashboard + taxonomy). If unset, in-memory cache is used.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=
# REDIS_TTL=300

# Postgres pool + slow-query log threshold (ms)
# DB_POOL_MAX=10
# SLOW_QUERY_MS=500

# Monitoring (optional)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
